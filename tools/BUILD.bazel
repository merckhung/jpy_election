load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# UTF-8 console output / argv on Windows (CommandLineToArgvW).
cc_library(
    name = "cli_utf8",
    hdrs = ["cli_utf8.h"],
    linkopts = select({
        "@platforms//os:windows": ["shell32.lib"],
        "//conditions:default": [],
    }),
)

# Results files: --template / --simulate / --check / --rollup / --night.
cc_binary(
    name = "results_tool",
    srcs = ["results_tool.cc"],
    deps = [
        ":cli_utf8",
        "//src/election",
        "//src/geo",
    ],
)

# News pipeline CLI: --fetch / --text / --stats / --mock / --eval ...
cc_binary(
    name = "news_tool",
    srcs = ["news_tool.cc"],
    deps = [
        ":cli_utf8",
        "//src/election",
        "//src/news",
        "//src/store",
        "@nlohmann_json//:json",
    ],
)
